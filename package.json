  "scripts": {
    "test": "node --test",
    "check": "node bin/aeo-check.js"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  },
  "keywords": ["aeo", "geo", "seo", "llms.txt", "ai-search", "chatgpt", "claude", "perplexity", "lint", "github-action"],
  "repository": { "type": "git", "url": "git+https://github.com/pchewlo/aeo-check.git" },
  "homepage": "https://github.com/pchewlo/aeo-check",
  "license": "MIT"
}
