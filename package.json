{
  "name": "aeo-check",
  "version": "0.1.0",
  "description": "Check a website's code for answer engine optimisation: whether ChatGPT, Claude, Perplexity, Gemini and Google AI Overviews can crawl, understand and cite it.",
  "type": "module",
  "bin": { "aeo-check": "bin/aeo-check.js" },
  "main": "src/index.js",
